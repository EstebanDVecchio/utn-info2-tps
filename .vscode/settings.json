{
  "C_Cpp.errorSquiggles": "disabled" ,   // Desactiva subrayado de errores en C/C++
  "editor.minimap.enabled": false,        // Saca el minimapa lateral
  "editor.renderWhitespace": "none",      // Menos ruido visual
  "workbench.activityBar.location": "top",// Barra más compacta
  "editor.fontSize": 14,
  "editor.tabSize": 4,
  "files.autoSave": "afterDelay",         // Guardado automático
  "editor.wordWrap": "on"                 // Útil para archivos largos
}