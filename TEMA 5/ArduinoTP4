// PINES DE LOS SENSORES

const int PIN_PIR2 = 2;
const int PIN_PIR1 = 3;

//Variables modificadas en interrupciones
volatile bool deteccionZ1 = false;
volatile bool deteccionZ2 = false;

// ESTRUCTURA DE LA LISTA ENLAZADA

struct NodoEvento {
  int zona;
  String marcaDeTiempo;
  NodoEvento* siguiente;
};

// Punteros globales para manejar la lista
NodoEvento* cabeza = nullptr;
NodoEvento* cola = nullptr;

// VARIABLES PARA EL RELOJ INTERNO

int dia, mes, anio, hora, minuto, segundo;
unsigned long ultimoMilisegundo = 0;
unsigned long ultimoReporte = 0;

// FUNCIONES DE INTERRUPCIÓN
void isrZona1() {
  deteccionZ1 = true;
}

void isrZona2() {
  deteccionZ2 = true; 
}

// SETUP

void setup() {
  Serial.begin(9600);
  pinMode(PIN_PIR1, INPUT);
  pinMode(PIN_PIR2, INPUT);

  // 1. Inicialización de Fecha y Hora por monitor serie
  Serial.println("--- SISTEMA DE SEGURIDAD INICIADO ---");
  Serial.println("Ingrese fecha y hora para inicializar el sistema.");
  Serial.println("Use el formato exacto: DD/MM/AAAA HH:MM:SS");

  // Esperar a que el usuario escriba en el monitor serie
  while (!Serial.available()) {
    // No hacer nada hasta recibir datos
  }

  // Leer entrada
  String entrada = Serial.readStringUntil('\n');
  entrada.trim(); // Limpiar espacios ocultos
  
  // Extraer los enteros de la cadena de texto usando sscanf
  sscanf(entrada.c_str(), "%d/%d/%d %d:%d:%d", &dia, &mes, &anio, &hora, &minuto, &segundo);
  
  Serial.print("Reloj configurado exitosamente a: ");
  Serial.println(obtenerMarcaDeTiempo());
  Serial.println("Esperando detecciones...");

  // Inicializar temporizadores
  ultimoMilisegundo = millis();
  ultimoReporte = millis();

  // 2. Configurar interrupciones
  // Usamos RISING para que se dispare justo cuando el sensor detecta movimiento (pasa de LOW a HIGH)
  attachInterrupt(digitalPinToInterrupt(PIN_PIR1), isrZona1, RISING);
  attachInterrupt(digitalPinToInterrupt(PIN_PIR2), isrZona2, RISING);
}

// LOOP PRINCIPAL

void loop() {
  // 1. Mantener el reloj actualizado
  actualizarReloj();

  // 2. Procesar evento de Zona 1 si la interrupción lo marcó
  if (deteccionZ1) {
    agregarEvento(1, obtenerMarcaDeTiempo());
    Serial.println("* Movimiento detectado en ZONA 1 (guardado en memoria) *");
    deteccionZ1 = false; // Bajar la bandera
  }

  // 3. Procesar evento de Zona 2 si la interrupción lo marcó
  if (deteccionZ2) {
    agregarEvento(2, obtenerMarcaDeTiempo());
    Serial.println("* Movimiento detectado en ZONA 2 (guardado en memoria) *");
    deteccionZ2 = false; // Bajar la bandera
  }

  // 4. Temporizador de 1 minuto (60,000 milisegundos)
  if (millis() - ultimoReporte >= 60000) {
    imprimirYLiberarLista();
    ultimoReporte = millis();
  }
}

// FUNCIONES AUXILIARES DE LA LISTA ENLAZADA
void agregarEvento(int numeroZona, String tiempo) {
  NodoEvento* nuevoNodo = new NodoEvento; 
  nuevoNodo->zona = numeroZona;
  nuevoNodo->marcaDeTiempo = tiempo;
  nuevoNodo->siguiente = nullptr;

  if (cabeza == nullptr) {
    cabeza = nuevoNodo;
    cola = nuevoNodo;
  } else {
    cola->siguiente = nuevoNodo;
    cola = nuevoNodo;
  }
}

void imprimirYLiberarLista() {
  Serial.println("\n=== REPORTE DE EVENTOS DEL ULTIMO MINUTO ===");
  
  if (cabeza == nullptr) {
    Serial.println("No se registraron eventos en este periodo.");
  } else {
    NodoEvento* actual = cabeza;
    
    // Recorrer la lista mientras haya nodos
    while (actual != nullptr) {
      Serial.print("-> Zona: ");
      Serial.print(actual->zona);
      Serial.print(" | Fecha y Hora: ");
      Serial.println(actual->marcaDeTiempo);

      // Guardar el nodo actual para borrarlo y avanzar al siguiente
      NodoEvento* nodoABorrar = actual;
      actual = actual->siguiente;
      
      // LIBERAR MEMORIA
      delete nodoABorrar; 
    }
    
    // Reiniciar los punteros
    cabeza = nullptr;
    cola = nullptr;
  }
  Serial.println("=== FIN DEL REPORTE (Memoria liberada) ===\n");
}


void actualizarReloj() {
  if (millis() - ultimoMilisegundo >= 1000) {
    ultimoMilisegundo += 1000;
    segundo++;
    if (segundo >= 60) {
      segundo = 0;
      minuto++;
      if (minuto >= 60) {
        minuto = 0;
        hora++;
        if (hora >= 24) {
          hora = 0;
          dia++;
        }
      }
    }
  }
}

// Devuelve un String formateado DD/MM/AAAA HH:MM:SS
String obtenerMarcaDeTiempo() {
  char buffer[20];
  sprintf(buffer, "%02d/%02d/%04d %02d:%02d:%02d", dia, mes, anio, hora, minuto, segundo);
  return String(buffer);
}